# Mobile (Expo) - variaveis de ambiente (MODELO)
#
# Copie para `mobile/.env` e ajuste o IP:
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
#
# 'api' consulta a plataforma e mostra erros ou respostas vazias na própria tela.
# 'demo' usa os dados simulados de src/data/mockData.ts, com indicação na tela.
EXPO_PUBLIC_DATA_MODE=api
#
# ATENCAO: no celular/Expo Go, `localhost` aponta para o proprio aparelho.
# Use o IP da maquina que roda o backend na mesma rede Wi-Fi.
#   Emulador Android: http://10.0.2.2:8080
#   Navegador dentro do Docker Compose: deixe vazio (proxy da mesma origem)
#   Celular fisico  : http://SEU_IP_LOCAL:8080

EXPO_PUBLIC_API_BASE_URL=
