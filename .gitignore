# =========================
# Oracle Cloud Infrastructure (Fase 6)
# Credenciais NUNCA sao versionadas: chave privada da API, fingerprint,
# tenancy/user OCID e o config pessoal ficam apenas na maquina do dev.
# =========================
.oci/
oci_config
oci_api_key*
*_oci_api_key*
*.pem
*.ppk
*.p12
*.pfx
*.key

# =========================
# Oracle Database local (Fase 6)
# O banco roda em container Docker, com os dados no volume
# `orbital-alert-oracle-data`. Nada do banco entra no repositorio.
# =========================
*.dbf
wallet/
tnsnames.ora
sqlnet.ora
oracle-local.env

# =========================
# Logs
# =========================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =========================
# Build / coverage folders
# =========================
build/
out/
coverage/

