#!/bin/sh
# Simple Maven Wrapper for Orbital Alert backend.
# Uses a local Maven distribution when available, falls back to system mvn,
# and can download Maven into .mvn/wrapper when Maven is not installed globally.

set -e

BASE_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
WRAPPER_DIR="$BASE_DIR/.mvn/wrapper"
PROPERTIES_FILE="$WRAPPER_DIR/maven-wrapper.properties"
MAVEN_VERSION=$(sed -n 's/^maven.version=//p' "$PROPERTIES_FILE" 2>/dev/null | head -n 1)
MAVEN_VERSION=${MAVEN_VERSION:-3.9.10}
MAVEN_HOME="$WRAPPER_DIR/apache-maven-$MAVEN_VERSION"
MAVEN_BIN="$MAVEN_HOME/bin/mvn"

if [ -x "$MAVEN_BIN" ]; then
  exec "$MAVEN_BIN" "$@"
fi

if command -v mvn >/dev/null 2>&1; then
  exec mvn "$@"
fi

mkdir -p "$WRAPPER_DIR"
DISTRIBUTION_URL=$(sed -n 's/^distributionUrl=//p' "$PROPERTIES_FILE" 2>/dev/null | head -n 1)
DISTRIBUTION_URL=${DISTRIBUTION_URL:-"https://archive.apache.org/dist/maven/maven-3/$MAVEN_VERSION/binaries/apache-maven-$MAVEN_VERSION-bin.tar.gz"}
ARCHIVE="$WRAPPER_DIR/apache-maven-$MAVEN_VERSION-bin.tar.gz"

echo "Maven $MAVEN_VERSION was not found locally. Downloading from: $DISTRIBUTION_URL"
if command -v curl >/dev/null 2>&1; then
  curl -fL "$DISTRIBUTION_URL" -o "$ARCHIVE"
elif command -v wget >/dev/null 2>&1; then
  wget -O "$ARCHIVE" "$DISTRIBUTION_URL"
else
  echo "Error: install curl or wget so the Maven Wrapper can download Maven." >&2
  exit 1
fi

tar -xzf "$ARCHIVE" -C "$WRAPPER_DIR"
exec "$MAVEN_BIN" "$@"
