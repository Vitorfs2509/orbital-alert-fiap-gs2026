# =========================================================
# Orbital Alert - variaveis de ambiente (MODELO)
# =========================================================
# Copie para `.env` e preencha com os SEUS valores.
# O `.env` real esta no .gitignore e NUNCA deve ser versionado.
# Nenhum valor secreto pode ser escrito neste arquivo de exemplo.
#
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env


# ---------------------------------------------------------
# Oracle Cloud Infrastructure - Object Storage (Fase 6)
# ---------------------------------------------------------
# Usado somente por `etl/sync_data_lake_to_oci.py`.
# Sem essas variaveis o projeto continua rodando normalmente:
# backend, ETLs, simulador e mobile nao dependem da Oracle.

# Bucket de destino do Data Lake. Unico valor obrigatorio para o upload real.
OCI_BUCKET_NAME=orbital-alert-datalake

# Namespace do Object Storage (Console: Tenancy details > Object storage namespace).
# Se ficar em branco, o proprio SDK descobre com get_namespace().
OCI_NAMESPACE=

# Arquivo de configuracao gerado por `oci setup config`.
# O padrao do SDK ja e ~/.oci/config - so preencha se usar outro caminho.
# ATENCAO: aponte para um arquivo FORA do repositorio.
OCI_CONFIG_FILE=

# Profile dentro do arquivo de configuracao (padrao: DEFAULT).
OCI_PROFILE=DEFAULT

# Regiao. Em branco, vale a regiao declarada no profile.
OCI_REGION=sa-saopaulo-1

# NAO coloque aqui (nem em nenhum arquivo versionado):
#   - chave privada da API (oci_api_key.pem)
#   - fingerprint
#   - user OCID / tenancy OCID
# Esses dados vivem apenas no arquivo ~/.oci/config da sua maquina.


# ---------------------------------------------------------
# IA generativa (Fase 5) - opcional
# ---------------------------------------------------------
# Sem a chave, o backend usa o MockAiClient deterministico.
OPENAI_API_KEY=


# ---------------------------------------------------------
# Mobile (Expo) - opcional
# ---------------------------------------------------------
# Este bloco pertence ao arquivo `mobile/.env` (veja mobile/.env.example).
# Sem a variavel, o app usa os dados mockados locais.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:8080
